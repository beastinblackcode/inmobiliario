# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to git!

[database]
# Google Drive file ID for the database
# Extract from URL: https://drive.google.com/file/d/{FILE_ID}/view
google_drive_file_id = "YOUR_GOOGLE_DRIVE_FILE_ID_HERE"

# Optional: If using PostgreSQL instead of Google Drive
# [postgres]
# host = "your-db-host.com"
# port = 5432
# database = "real_estate"
# user = "your_username"
# password = "your_password"


# ── Authentication ───────────────────────────────────────────────────────────
# PREFERRED: bcrypt-hashed passwords.
# Generate hashes with:  python gen_password_hash.py
# (Plaintext is read but emits a deprecation warning to stderr.)
[auth.users_hashed]
# luis = "$2b$12$KxJ1r7..."
# admin = "$2b$12$..."

# DEPRECATED — kept for backward compatibility only. Prefer users_hashed.
# [auth.users]
# luis = "your-plaintext-password"
